def xac_minh():
    try:
        if public_key is None:
            messagebox.showerror(
                "Lỗi",
                "Chưa có khóa công khai"
            )
            return
        if signature_r is None:
            messagebox.showerror(
                "Lỗi",
                "Chưa tải chữ ký"
            )
            return
        van_ban = txt_verify.get(
            "1.0",
            END
        ).strip()
        if len(van_ban) == 0:
            messagebox.showerror(
                "Lỗi",
                "Chưa có văn bản kiểm tra"
            )
            return
        p, g, y = public_key
        r = signature_r
        s = signature_s
        m = bam_sha256_int(
            van_ban,
            p - 1
        )
        hash_hien_tai = bam_sha256(
            van_ban
        )
        V1 = (
            mod_pow(
                y,
                r,
                p
            )
            *
            mod_pow(
                r,
                s,
                p
            )
        ) % p
        V2 = mod_pow(
            g,
            m,
            p
        )
        chu_ky_hop_le = (
            V1 == V2

        )
        hash_hop_le = (
            hash_hien_tai == signature_hash

        )
        if chu_ky_hop_le and hash_hop_le:
            ket_qua = "✓ Chữ ký hợp lệ"
        elif chu_ky_hop_le and not hash_hop_le:
            ket_qua = "✗ Văn bản đã bị sửa"
        elif not chu_ky_hop_le and hash_hop_le:
            ket_qua = "✗ Chữ ký đã bị sửa"
        else:
            ket_qua = "✗ Văn bản và chữ ký đều đã bị thay đổi"
        lbl_verify_result.config(
            text=ket_qua
        )
        ghi_log(
            ket_qua
        )
        messagebox.showinfo(
            "Kết quả xác minh",
            ket_qua
        )
    except Exception as e:
        messagebox.showerror(
            "Lỗi",
            str(e)
        )
