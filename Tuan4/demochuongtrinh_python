# KÝ SỐ ELGAMAL
# ==========================================================
def ky_so():
    global signature_r
    global signature_s
    global signature_hash
    signature_hash
    try:
        van_ban = txt_vanban.get(
            "1.0",
            END
        ).strip()
        if van_ban == "":
            messagebox.showerror(
                "Lỗi",
                "Chưa có văn bản"
            )
            return
        p, g, y = public_key
        x = private_key
        m = bam_sha256_int(
            van_ban,
            p - 1
        )
        hash_value = bam_sha256(
            van_ban
        )
        hien_thi_hash(
            hash_value
        )
        while True:
            k = random.randint(
                2,
                p - 2
            )
            if gcd(
                k,
                p - 1
            ) == 1:
                break
        r = mod_pow(
            g,
            k,
            p
        )
        k_inverse = mod_inverse(
            k,
            p - 1
        )
        s = (
            k_inverse *
            (
                m -
                x * r
            )
        ) % (
            p - 1
        )
        signature_r = r
        signature_s = s
        signature_hash = hash_value
        entry_r.config(
            state="normal"
        )
        entry_s.config(
            state="normal"
        )
        entry_r.delete(
            0,
            END
        )
        entry_s.delete(
            0,
            END
        )
        entry_r.insert(
            0,
            str(r)
        )
        entry_s.insert(
            0,
            str(s)
        )
        entry_r.config(
            state="readonly"
        )
        entry_s.config(
            state="readonly"
        )
        ghi_log(
            "Ký số thành công"
        )
        messagebox.showinfo(
            "Thông báo",
            "Đã tạo chữ ký điện tử"
        )
    except Exception as e:
        messagebox.showerror(
            "Lỗi",
            str(e)
     )
