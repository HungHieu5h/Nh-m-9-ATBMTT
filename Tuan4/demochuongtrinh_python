# ==========================================================
# KIEM TRA CAN NGUYEN THUY
# ==========================================================
def la_can_nguyen_thuy(g, p):
    phi = p - 1
    factors = []

    n = phi
    i = 2

    while i * i <= n:
        if n % i == 0:
            factors.append(i)
            while n % i == 0:
                n //= i
        i += 1

    if n > 1:
        factors.append(n)

    for f in factors:
        if mod_pow(g, phi // f, p) == 1:
            return False

    return True      
