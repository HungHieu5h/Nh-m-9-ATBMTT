# ==========================================================
# ĐỌC FILE DOCX
# ==========================================================
def doc_docx(file_path):
    doc = Document(
        file_path
    )
    noi_dung = ""
    for para in doc.paragraphs:
        noi_dung += para.text
        noi_dung += "\n"
    return noi_dung
# ==========================================================
# ĐỌC FILE PDF
# ==========================================================
def doc_pdf(file_path):
    reader = PdfReader(
        file_path
    )
    noi_dung = ""
    for page in reader.pages:
        text = page.extract_text()
        if text:
            noi_dung += text
            noi_dung += "\n"
    return noi_dung
