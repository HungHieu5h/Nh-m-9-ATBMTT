# ==========================================================
# KIỂM TRA NGUYÊN TỐ
# ==========================================================
def la_so_nguyen_to(n):
    if n < 2:
        return False
    if n == 2:
        return True
    if n % 2 == 0:
        return False
    i = 3
    while i * i <= n:
        if n % i == 0:
            return False
        i += 2
    return True
# ==========================================================
# TÌM ƯỚC CHUNG LỚN NHẤT
# ==========================================================
def gcd(a, b):
    while b != 0:
        a, b = b, a % b
    return a
# ==========================================================
# LŨY THỪA MOD
# ==========================================================
def mod_pow(base, exp, mod):
    result = 1
    base %= mod
    while exp > 0:
        if exp & 1:
            result = (result * base) % mod
        base = (base * base) % mod
        exp >>= 1
    return result
# =========================================================
# NGHỊCH ĐẢO MOD
# ==========================================================
def mod_inverse(a, m):
    m0 = m
    x0 = 0
    x1 = 1
    if m == 1:
        return 0
    while a > 1:
        q = a // m
        t = m
        m = a % m
        a = t
        t = x0
        x0 = x1 - q * x0
        x1 = t
    if x1 < 0:
        x1 += m0
    return x1
# ==========================================================
# SHA256
# ==========================================================
def bam_sha256(van_ban):
    gia_tri_bam = hashlib.sha256(
        van_ban.encode("utf-8")
    ).hexdigest()
    return gia_tri_bam
# ==========================================================
# SHA256 -> INT
# =========================================================
def bam_sha256_int(van_ban, mod):
    h = hashlib.sha256(
        van_ban.encode("utf-8")
    ).hexdigest()
    return int(h, 16) % mod
