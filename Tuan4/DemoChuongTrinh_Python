import customtkinter as ctk
from tkinter import messagebox
import math

# Thiết kế chủ đề
ctk.set_appearance_mode("System")
ctk.set_default_color_theme("blue")

# =============================================================================
# THUẬT TOÁN SỐ HỌC (Chuẩn ElGamal)
# =============================================================================
def mod_inverse(a, m):
    return pow(a, -1, m)

def power(base, exp, mod):
    return pow(base, exp, mod)

# =============================================================================
# GIAO DIỆN ỨNG DỤNG
# =============================================================================
class ModernElGamalApp(ctk.CTk):
    def __init__(self):
        super().__init__()
        self.title("Nhóm 9 - Hệ thống Chữ ký điện tử ElGamal")
        self.geometry("1280x680")
        self.resizable(False, False)

        title_lbl = ctk.CTkLabel(self, text="PHẦN MỀM MÔ PHỎNG CHỮ KÝ ĐIỆN TỬ ELGAMAL", 
                                 font=ctk.CTkFont(family="Arial", size=18, weight="bold"))
        title_lbl.pack(pady=15)

        main_container = ctk.CTkFrame(self, fg_color="transparent")
        main_container.pack(fill="both", expand=True, padx=20, pady=10)

        # CỘT 1: CẤU HÌNH KHÓA
        col1 = ctk.CTkFrame(main_container, width=280)
        col1.pack(side="left", fill="both", expand=True, padx=10)
        
        ctk.CTkLabel(col1, text="🔑 Cấu Hình & Tạo Khóa", font=ctk.CTkFont(size=14, weight="bold"), text_color="#1F6AA5").pack(pady=10)

        self.ent_p = self.create_input(col1, "Số nguyên tố p:")
        self.ent_g = self.create_input(col1, "Phần tử sinh g:")
        self.ent_x = self.create_input(col1, "Khóa bí mật x:")

        ctk.CTkButton(col1, text="Tạo Cặp Khóa", font=ctk.CTkFont(weight="bold"), command=self.generate_keys).pack(fill="x", padx=20, pady=15)

        self.ent_y = self.create_readonly(col1, "Khóa công khai y (y = g^x mod p):")
        self.ent_kpub = self.create_readonly(col1, "Khóa Công Khai (p, g, y):")
        self.ent_kpr = self.create_readonly(col1, "Khóa Bí Mật (p, g, x):")

        ctk.CTkButton(col1, text="Xóa toàn bộ", fg_color="#A83232", command=self.clear_all).pack(fill="x", padx=20, pady=(40, 5))

        # CỘT 2: TẠO CHỮ KÝ
        col2 = ctk.CTkFrame(main_container)
        col2.pack(side="left", fill="both", expand=True, padx=10)

        ctk.CTkLabel(col2, text="✍️ Quá Trình Ký Số", font=ctk.CTkFont(size=14, weight="bold"), text_color="#229954").pack(pady=10)
        
        ctk.CTkLabel(col2, text="Bản rõ (Văn bản):").pack(anchor="w", padx=20)
        self.txt_plain = ctk.CTkTextbox(col2, height=150)
        self.txt_plain.pack(fill="x", padx=20, pady=2)

        k_frame = ctk.CTkFrame(col2, fg_color="transparent")
        k_frame.pack(fill="x", padx=20, pady=10)
        ctk.CTkLabel(k_frame, text="Số ngẫu nhiên k: ").pack(side="left")
        self.ent_k = ctk.CTkEntry(k_frame)
        self.ent_k.pack(side="left", padx=10, expand=True, fill="x")

        ctk.CTkButton(col2, text="Thực Hiện Ký", fg_color="#229954", command=self.sign_text).pack(fill="x", padx=20, pady=5)
        ctk.CTkLabel(col2, text="Chữ ký (r, s):").pack(anchor="w", padx=20, pady=(10,0))
        self.txt_cipher_output = ctk.CTkTextbox(col2, height=150)
        self.txt_cipher_output.pack(fill="x", padx=20, pady=2)
        ctk.CTkButton(col2, text="Chuyển sang xác thực ➔", fg_color="#E67E22", command=self.transfer_data).pack(pady=15)

        # CỘT 3: XÁC MINH
        col3 = ctk.CTkFrame(main_container)
        col3.pack(side="left", fill="both", expand=True, padx=10)

        ctk.CTkLabel(col3, text="🔍 Xác Minh Chữ Ký", font=ctk.CTkFont(size=14, weight="bold"), text_color="#7D3C98").pack(pady=10)
        self.txt_cipher_input = ctk.CTkTextbox(col3, height=150)
        self.txt_cipher_input.pack(fill="x", padx=20, pady=2)
        ctk.CTkButton(col3, text="Kiểm Tra Chữ Ký", fg_color="#7D3C98", command=self.verify_text).pack(fill="x", padx=20, pady=12)
        self.txt_verify_res = ctk.CTkTextbox(col3, height=180)
        self.txt_verify_res.pack(fill="x", padx=20, pady=2)

    # --- HÀM HỖ TRỢ GIAO DIỆN ---
    def create_input(self, parent, label_text):
        ctk.CTkLabel(parent, text=label_text).pack(anchor="w", padx=20)
        ent = ctk.CTkEntry(parent)
        ent.pack(fill="x", padx=20, pady=2)
        return ent

    def create_readonly(self, parent, label_text):
        ctk.CTkLabel(parent, text=label_text).pack(anchor="w", padx=20)
        ent = ctk.CTkEntry(parent, state="readonly")
        ent.pack(fill="x", padx=20, pady=2)
        return ent

    def update_readonly(self, ent, val):
        ent.configure(state="normal"); ent.delete(0, "end"); ent.insert(0, val); ent.configure(state="readonly")

    # --- HÀM LOGIC ELGAMAL ---
    def generate_keys(self):
        try:
            p, g, x = int(self.ent_p.get()), int(self.ent_g.get()), int(self.ent_x.get())
            y = power(g, x, p)
            self.update_readonly(self.ent_y, str(y))
            self.update_readonly(self.ent_kpub, f"({p}, {g}, {y})")
            self.update_readonly(self.ent_kpr, f"({p}, {g}, {x})")
        except: messagebox.showerror("Lỗi", "Vui lòng nhập số nguyên!")

    def sign_text(self):
        try:
            p, g, x, k = int(self.ent_p.get()), int(self.ent_g.get()), int(self.ent_x.get()), int(self.ent_k.get())
            plain_text = self.txt_plain.get("1.0", "end-1c")
            self.txt_cipher_output.delete("1.0", "end")
            for char in plain_text:
                m = ord(char)
                r = power(g, k, p)
                s = ((m - x * r) * mod_inverse(k, p - 1)) % (p - 1)
                self.txt_cipher_output.insert("end", f"({r},{s})\n")
        except: messagebox.showerror("Lỗi", "Dữ liệu hoặc tham số không hợp lệ!")

    def transfer_data(self):
        self.txt_cipher_input.delete("1.0", "end")
        self.txt_cipher_input.insert("1.0", self.txt_cipher_output.get("1.0", "end-1c"))

    def verify_text(self):
        try:
            p, g, y = int(self.ent_p.get()), int(self.ent_g.get()), int(self.ent_y.get())
            lines = self.txt_cipher_input.get("1.0", "end-1c").strip().split("\n")
            valid_text = ""
            for line in lines:
                r, s = map(int, line.replace("(", "").replace(")", "").split(","))
                # Xác thực: g^m ≡ y^r * r^s (mod p)
                v_right = (power(y, r, p) * power(r, s, p)) % p
                found = next((chr(m) for m in range(256) if power(g, m, p) == v_right), "?")
                valid_text += found
            self.txt_verify_res.delete("1.0", "end")
            self.txt_verify_res.insert("end", f"✔️ Chữ ký hợp lệ!\n\nNội dung: {valid_text}")
        except: messagebox.showerror("Lỗi", "Định dạng chữ ký không hợp lệ!")

    def clear_all(self):
        for ent in [self.ent_p, self.ent_g, self.ent_x, self.ent_k]: ent.delete(0, "end")
        for ent in [self.ent_y, self.ent_kpub, self.ent_kpr]: self.update_readonly(ent, "")
        for txt in [self.txt_plain, self.txt_cipher_output, self.txt_cipher_input, self.txt_verify_res]: txt.delete("1.0", "end")

if __name__ == "__main__":
    app = ModernElGamalApp()
    app.mainloop()
